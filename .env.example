APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080

# Server timeouts. SERVER_WRITE_TIMEOUT must exceed AI_TIMEOUT so long Gemini
# responses (which can take 10-30s) are not cut off mid-write.
SERVER_READ_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend?sslmode=disable
RATE_LIMIT_ENABLED=true

JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# AI - Gemini 
AI_PROVIDER=gemini
AI_API_KEY=isi_api_key_gemini_anda
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Model
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_MODELS=gemini-3.8-flash
AI_THINKING_LEVEL=LOW
AI_THINKING_LEVELS=gemini-3.5-flash=LOW,gemini-3.8-flash=LOW
AI_MAX_OUTPUT_TOKENS=32768
AI_MAX_REQUEST_BYTES=1048576

# Waktu tunggu 
AI_TIMEOUT=120s
AI_RETRY_ON_UNAVAILABLE=1
AI_RETRY_BACKOFF=2s
AI_OPEN_BUDGET=150s
AI_DAILY_QUOTA_LIMIT=20
AI_STREAM_MAX_DURATION=180s
AI_STREAM_IDLE_TIMEOUT=30s
AI_HEDGE_AFTER=0

# Server
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_WRITE_TIMEOUT=300s

# Debug
AI_DEBUG_LOG_OUTPUT_EDGES=false



# AI_RETRY_ON_UNAVAILABLE=2
# AI_RETRY_BACKOFF=3s

