# Application
APP_ENV=development
APP_NAME=backend
APP_HOST=0.0.0.0
APP_PORT=8080

# Server timeouts. SSE generate/revise streams refresh their own write
# deadline on every event/heartbeat, so a healthy stream is NOT cut by
# SERVER_WRITE_TIMEOUT; the total stream lifetime is bounded by AI_TIMEOUT
# (provider calls) instead.
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s

# PostgreSQL
# Primary option: full connection string (recommended for Supabase).
# EXAMPLE ONLY - replace with your real Supabase connection string in your
# local .env. Never commit the real value.
DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.co:5432/postgres?sslmode=require

# Alternative: individual connection settings.
# Used only when DATABASE_URL is empty. sslmode=require is required for a
# cloud database such as Supabase; keep =disable only for local testing.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=backend
DATABASE_SSLMODE=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_HEALTH_CHECK_PERIOD=1m

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION=24h
JWT_ISSUER=backend

# AI - Gemini (Google Generative Language API; leave API key empty to keep AI disabled until needed)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT=30s
AI_MAX_REQUEST_BYTES=1048576
# JSON body cap for generate/revise only (base64 images inflate ~33%, so this
# is roomier than the global limit above; matches the 32 MB multipart buffer).
# Prefer multipart/form-data when sending images.
AI_MAX_GENERATE_BODY_BYTES=33554432
# Optional Gemini generation knobs. When empty, generationConfig is NOT sent
# and model defaults apply. AI_MAX_OUTPUT_TOKENS caps output tokens (> 0).
# AI_THINKING_BUDGET caps thinking tokens (>= 0; 0 disables thinking where the
# model supports it). Useful when outputs get cut off or to bound cost.
# AI_MAX_OUTPUT_TOKENS=
# AI_THINKING_BUDGET=
# Debug aid (development ONLY): log first/last 200 chars of failed model
# output. Output may contain user data — never enable outside development.
# Ignored with a startup warning when APP_ENV is not development.
# AI_DEBUG_LOG_OUTPUT_EDGES=false

# AI Website Generator - generate/revise rate limiting (per IP, additional
# on top of the general API limit)
GENERATE_RATE_LIMIT_ENABLED=true
GENERATE_RATE_LIMIT_PER_MINUTE=5

# AI Website Generator - project limits
# Max reference images per generate/revise request.
PROJECT_MAX_IMAGES=4
# Max validated AI-produced HTML document size in bytes (512 KiB default:
# generous for a single self-contained file while bounding memory/DB growth).
PROJECT_MAX_HTML_BYTES=524288

# Code Execution Sandbox - Judge0 CE (DEFERRED: not registered in the router;
# these variables are optional and the server boots without them)
EXEC_PROVIDER=judge0
EXEC_BASE_URL=http://localhost:2358
EXEC_API_KEY=
EXEC_CPU_TIME_LIMIT_SEC=5
EXEC_WALL_TIME_LIMIT_SEC=10
EXEC_MEMORY_LIMIT_KB=131072
EXEC_MAX_CODE_BYTES=65536

# Upload Storage (Documents & Multimodal Images)
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# CORS - comma-separated list of allowed origins (exact match, echoed back;
# never "*" alongside Authorization). When unset, development allows
# http://localhost:3000,http://localhost:5173; outside development nothing
# is allowed. Always set this explicitly in production.
# Development example (Vite default): http://localhost:5173
# Production example:   https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (general API endpoints)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=120
