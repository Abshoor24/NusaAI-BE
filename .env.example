# Application
APP_ENV=development
APP_NAME=backend
APP_HOST=0.0.0.0
APP_PORT=8080

# Server timeouts. SSE generate/revise streams refresh their own write
# deadline on every event/heartbeat, so a healthy stream is NOT cut by
# SERVER_WRITE_TIMEOUT; the open phase is bounded by AI_OPEN_BUDGET and the
# relay by AI_STREAM_MAX_DURATION instead.
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s

# PostgreSQL
# Primary option: full connection string (recommended for Supabase).
# EXAMPLE ONLY - replace with your real Supabase connection string in your
# local .env. Never commit the real value.
DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.co:5432/postgres?sslmode=require

# Alternative: individual connection settings.
# Used only when DATABASE_URL is empty. sslmode=require is required for a
# cloud database such as Supabase; keep =disable only for local testing.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=backend
DATABASE_SSLMODE=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_HEALTH_CHECK_PERIOD=1m

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION=24h
JWT_ISSUER=backend

# AI - Gemini (Google Generative Language API; leave API key empty to keep AI disabled until needed)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
# Comma-separated list of fallback models attempted if AI_MODEL encounters 503 (overload), 429, or 404.
AI_FALLBACK_MODELS=gemini-3.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Per-HTTP-request bound for the provider open (response headers). 25s is
# only safe together with a low thinking level (AI_THINKING_LEVEL=LOW or
# lower); raise it if the model is configured to think more.
AI_TIMEOUT=25s
AI_MAX_REQUEST_BYTES=1048576
# JSON body cap for generate/revise only (base64 images inflate ~33%, so this
# is roomier than the global limit above; matches the 32 MB multipart buffer).
# Prefer multipart/form-data when sending images.
AI_MAX_GENERATE_BODY_BYTES=33554432
# Optional Gemini generation knobs. When empty, generationConfig is NOT sent
# and model defaults apply. AI_MAX_OUTPUT_TOKENS caps output tokens (> 0).
# AI_THINKING_BUDGET caps thinking tokens (>= 0; 0 disables thinking where the
# model supports it). Useful when outputs get cut off or to bound cost.
# AI_MAX_OUTPUT_TOKENS=
# AI_THINKING_BUDGET=
# Gemini 3.x thinking level. Supported values: MINIMAL, LOW, MEDIUM, HIGH.
# MINIMAL is not supported by gemini-3.8-flash / gemini-3.7-flash and is
# omitted for those models automatically. Empty disables the field (model
# default). Per-model overrides use model=LEVEL pairs, e.g.
# AI_THINKING_LEVELS=gemini-3.5-flash=MINIMAL,gemini-3.8-flash=LOW
AI_THINKING_LEVEL=LOW
# AI_THINKING_LEVELS=
# Debug aid (development ONLY): log first/last 200 chars of failed model
# output. Output may contain user data — never enable outside development.
# Ignored with a startup warning when APP_ENV is not development.
# AI_DEBUG_LOG_OUTPUT_EDGES=false
# Total open-phase budget shared by every retry and fallback model before
# the provider stream is open. On exhaustion the request stops, rolls back,
# and the client gets SSE AI_BUSY "Server AI sedang ramai. Silakan coba lagi
# sebentar lagi." SSE headers are already committed before this phase, so
# this is always an SSE error event, never a JSON 502.
AI_OPEN_BUDGET=60s
# Lifetime bound for the token relay only; it starts AFTER the provider
# stream opens, so a slow open never eats the streaming budget. Past this
# the Gemini request is cancelled, the project rolls back, and the client
# gets AI_PROVIDER_ERROR "AI stream timed out".
AI_STREAM_MAX_DURATION=180s
# Silence bound between provider chunks. No new chunk within this window
# ends the stream as AI_PROVIDER_ERROR "AI stream stalled" (same rollback).
AI_STREAM_IDLE_TIMEOUT=30s
# Limited same-model retry on provider overload (HTTP 503 or a temporary 429
# before any chunk exists), 0-2 extra attempts with AI_RETRY_BACKOFF pause
# between them. After those attempts the next fallback model is tried. A 429
# is classified from error.details: quotaId containing "PerDay" OR a RetryInfo
# delay above 120s means the DAILY quota is exhausted, so the same model is not
# retried and the next model is tried immediately. That model is remembered in
# memory and skipped until its RetryInfo delay expires (24h if absent). A
# temporary 429 with RetryInfo <= 10s is retried once after exactly that delay;
# a larger delay follows the normal 503 retry policy. If every model's daily
# quota is exhausted the client gets AI_BUSY with reason "quota" and:
# "Kuota AI harian telah habis. Silakan coba lagi nanti atau hubungi
# penyelenggara."
# Response header timeouts are NOT retried on the same model (straight to
# fallback). Never retries mid-stream errors, truncation, blocks, or validation.
AI_RETRY_ON_UNAVAILABLE=1
AI_RETRY_BACKOFF=2s
# Opt-in request hedging. When > 0 and AI_FALLBACK_MODELS is non-empty, the
# first fallback model starts in parallel if the primary has not produced its
# first chunk within this delay. The first model to produce a chunk wins and
# the loser is cancelled. Default 0 disables hedging. Hedging can roughly
# double provider billing for slow opens, so keep it off unless latency
# matters. Recommended: AI_HEDGE_AFTER=8s with gemini-3.5-flash and
# AI_THINKING_LEVEL=LOW.
AI_HEDGE_AFTER=0

# AI Website Generator - generate/revise rate limiting (per IP, additional
# on top of the general API limit)
GENERATE_RATE_LIMIT_ENABLED=true
GENERATE_RATE_LIMIT_PER_MINUTE=5

# AI Website Generator - project limits
# Max reference images per generate/revise request.
PROJECT_MAX_IMAGES=4
# Max validated AI-produced HTML document size in bytes (512 KiB default:
# generous for a single self-contained file while bounding memory/DB growth).
PROJECT_MAX_HTML_BYTES=524288

# Upload Storage (Reference Images)
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# CORS - comma-separated list of allowed origins (exact match, echoed back;
# never "*" alongside Authorization). When unset, development allows
# http://localhost:3000,http://localhost:5173; outside development nothing
# is allowed. Always set this explicitly in production.
# Development example (Vite default): http://localhost:5173
# Production example:   https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (general API endpoints)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=120
